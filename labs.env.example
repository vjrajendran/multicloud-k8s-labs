# cp labs.env.example labs.env     (labs.env is git-ignored - never commit keys)
#
# One block per Pluralsight sandbox; the number is the team member (1-3).
# A sandbox is built when its credentials are filled in - leave a block
# empty to skip it today. Then run ./up.sh
#
# Per sandbox (all optional):
#   _KUBEADM  kubeadm clusters (master1 + client1 + client2 VMs)
#   _MANAGED  EKS / AKS / GKE clusters
#   _NODES    nodes per managed cluster (default 2)
#   _REGION   region (Azure: location)
#   _CLOUD_LB 1 = AWS cloud controller on the kubeadm clusters, so Services
#             of type LoadBalancer get real AWS load balancers (AWS only)
#
# What fits in ONE sandbox (Pluralsight limits):
#   AWS    9 instances           kubeadm = 3 instances,  EKS = NODES instances
#          e.g. KUBEADM=3  |  KUBEADM=2 MANAGED=1 NODES=3  |  MANAGED=3 NODES=3
#   Azure  10 vCPU, 10 VMs,      kubeadm = 4 vCPU,  AKS node = 2 vCPU, max 2 AKS
#          e.g. KUBEADM=2  |  KUBEADM=1 MANAGED=1 NODES=2  |  MANAGED=2 NODES=2
#   GCP    12 vCPU, 10 VMs       kubeadm = 6 vCPU,  GKE node = 2 vCPU
#          e.g. KUBEADM=2  |  KUBEADM=1 MANAGED=1 NODES=3  |  MANAGED=2 NODES=3

# ============================ AWS ============================
# Sandbox page: "Access Key ID" / "Secret Access Key"

AWS1_ACCESS_KEY_ID=
AWS1_SECRET_ACCESS_KEY=
AWS1_KUBEADM=3
AWS1_MANAGED=0

AWS2_ACCESS_KEY_ID=
AWS2_SECRET_ACCESS_KEY=
AWS2_KUBEADM=3
AWS2_MANAGED=0

AWS3_ACCESS_KEY_ID=
AWS3_SECRET_ACCESS_KEY=
AWS3_KUBEADM=3
AWS3_MANAGED=0

# =========================== Azure ===========================
# From the sandbox page: Username, Application Client ID and Secret (the
# password isn't needed). The tenant, subscription and resource group are
# looked up automatically; set _TENANT_ID / _SUBSCRIPTION_ID /
# _RESOURCE_GROUP only to override them.
# No client ID on the page? Set _LOGIN=device instead and up.sh prints a
# code to enter at microsoft.com/devicelogin.

AZURE1_USERNAME=
AZURE1_CLIENT_ID=
AZURE1_CLIENT_SECRET=
AZURE1_KUBEADM=2
AZURE1_MANAGED=0

AZURE2_USERNAME=
AZURE2_CLIENT_ID=
AZURE2_CLIENT_SECRET=
AZURE2_KUBEADM=2
AZURE2_MANAGED=0

AZURE3_USERNAME=
AZURE3_CLIENT_ID=
AZURE3_CLIENT_SECRET=
AZURE3_KUBEADM=2
AZURE3_MANAGED=0

# ============================ GCP ============================
# PROJECT is the sandbox's project ID. Leave CREDENTIALS empty to sign in
# with the sandbox username/password (up.sh prints a link), or point it at
# a service-account JSON key.

GCP1_PROJECT=
GCP1_CREDENTIALS=
GCP1_KUBEADM=2
GCP1_MANAGED=0

GCP2_PROJECT=
GCP2_CREDENTIALS=
GCP2_KUBEADM=2
GCP2_MANAGED=0

GCP3_PROJECT=
GCP3_CREDENTIALS=
GCP3_KUBEADM=2
GCP3_MANAGED=0
